# Hostinger SMTP Configuration
# Replace these values with your actual Hostinger email settings

# SMTP Host (Hostinger's SMTP server)
SMTP_HOST=smtp.hostinger.com

# SMTP Port (465 for SSL)
SMTP_PORT=465

# Your Hostinger email address
SMTP_USER=sales@anayaescapes.com

# Your Hostinger email password
SMTP_PASS=your_email_password_here

# Environment
NODE_ENV=production
